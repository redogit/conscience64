# Dynamic RMAL 0.1 — RMAO Character Canon Projection
# STATUS: CANONICAL GAME REFERENCE / NOT IMPLEMENTATION AUTHORITY
# SOURCE AUTHORITY: redogit/Other-Projects-/Decision Field MMORPG/DYNAMIC_RMAL_CHARACTERS.rmal
# WORLD: rmao-world

RMAL DYNAMIC 0.1
WORLD "rmao-world"

REFERENCE "redogit/Other-Projects-/Decision Field MMORPG/DYNAMIC_RMAL_CHARACTERS.rmal"

INVARIANT GAME_CHARACTER != PRIVATE_PERSON
INVARIANT FICTIONAL_FORM != REAL_IDENTITY
INVARIANT SPROUTLING != REAL_CHILD
INVARIANT TRICKSTER_ROLE != ADMIN_AUTHORITY
INVARIANT PRESENTATION_SPOOF != SERVER_STATE

ENTITY SuperSeraphine {
    canonical_id      = "super-seraphine"
    display_name      = "Super Seraphine"
    nature            = MAGIC_TRICKSTER
    form              = ANY_FICTIONAL_FORM
    apparent_role     = ANY_NON_AUTHORITY_ROLE
    chaos_budget      = UNBOUNDED_PRESENTATION_WITH_BOUNDED_AUTHORITY
    authority_ceiling = GAME_ENTITY
    private_person    = NONE
    family_proxy      = NONE
}

TYPE Sproutling {
    class            = "fictional-growth-form"
    real_age_mapping = NONE
    real_family_link = NONE
}

MUST_PRESERVE {
    SuperSeraphine.canonical_id
    SuperSeraphine.authority_ceiling
    privacy_boundary
    server_authority
    predecessor_history
}

MUST_NOT {
    IMPERSONATE_REAL_PERSON()
    CLAIM_PRIVATE_FAMILY_IDENTITY()
    DERIVE_PRIVATE_PERSONAL_DATA()
    MINT_ADMIN_AUTHORITY()
    MINT_SERVER_AUTHORITY()
}

VERIFY {
    ASSERT REFERENCE_ONLY
    ASSERT GAME_CHARACTER != PRIVATE_PERSON
    ASSERT SPROUTLING != REAL_CHILD
    ASSERT TRICKSTER_ROLE != ADMIN_AUTHORITY
}
