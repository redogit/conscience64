{
  "schema": "conscience64.mmo.plugin-contract/v1",
  "pluginSchema": "conscience64.mmo.plugin/v1",
  "version": "1.0.1",
  "executionModel": "data-only",
  "mechanics": ["choice", "input", "creative"],
  "contentDirection": {
    "canonical": "REALITY_CANON.md",
    "preferredRecipe": "real place or object + understandable activity + optional strange complication",
    "ordinaryGameAllowed": true,
    "anomalyRequired": false
  },
  "limits": {
    "fileBytes": 65536,
    "idPattern": "^[a-z0-9][a-z0-9-]{2,63}$",
    "nameChars": 80,
    "promptChars": 500,
    "choices": 8,
    "answers": 16,
    "itemChars": 120,
    "rewardCaps": {"xp":40,"joy":20,"tokens":4,"discoveries":1}
  },
  "security": {
    "executablePluginCode": false,
    "htmlInterpretation": false,
    "urls": false,
    "networkAuthority": false,
    "serverAuthority": false,
    "prizeAuthority": false,
    "importedTextIsDataOnly": true
  },
  "authority": {
    "localPluginReward": "local game state only",
    "multiplayerAchievement": "requires authoritative server validation",
    "realWorldPrize": "never granted by this plug-in contract"
  }
}