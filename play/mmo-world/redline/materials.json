{
  "schema": "conscience64.redline.character-materials/v1",
  "characterId": "redline-shapeshifter",
  "ageClass": "adult",
  "status": "design-spec-not-production-canon",
  "presentation": {
    "tone": ["risky", "provocative", "neon-noir", "rain-soaked", "adult-fictional-character"],
    "boundary": "Non-explicit base-game presentation. Provocation comes from silhouette, fashion, danger, lighting and transformation effects rather than nudity or sexual acts."
  },
  "pbrChannels": ["baseColor", "normal", "roughness", "metallic", "ao", "height", "emissive", "opacity"],
  "families": {
    "skin": {
      "channels": ["baseColor", "normal", "roughness", "ao"],
      "optional": ["subsurfaceMask", "microNormal"],
      "notes": "Fictional adult character skin material; no biometric reconstruction from source imagery."
    },
    "hair": {
      "channels": ["baseColor", "normal", "roughness", "opacity"],
      "optional": ["strandDirection", "wetnessMask"]
    },
    "technicalFabric": {
      "channels": ["baseColor", "normal", "roughness", "ao"],
      "optional": ["weaveMask", "waterDarkeningMask", "wearMask"]
    },
    "leatherAndCoatedTextile": {
      "channels": ["baseColor", "normal", "roughness", "ao"],
      "optional": ["clearcoatMask", "creaseMask", "rainBeadMask"]
    },
    "metalHardware": {
      "channels": ["baseColor", "normal", "roughness", "metallic", "ao"],
      "optional": ["scratchMask", "edgeWearMask"]
    },
    "glassAndVisor": {
      "channels": ["baseColor", "normal", "roughness", "opacity"],
      "optional": ["rainStreakMask", "fingerprintMask", "emissiveReflectionMask"]
    },
    "redlineEmissive": {
      "channels": ["emissive", "opacity"],
      "notes": "Sparse pulse accents for state changes, danger cues and silhouette readability."
    }
  },
  "overlays": [
    "wetness",
    "rain-beads",
    "rain-streaks",
    "street-grime",
    "soot",
    "dust",
    "fabric-wear",
    "edge-scratches",
    "peeling-print",
    "temporary-damage",
    "neon-reflection"
  ],
  "rules": {
    "preferReusableMasks": true,
    "preferMaterialInstances": true,
    "duplicateTextureSetsOnlyWhen": "a state cannot be represented by bounded parameter or mask changes without visible artifacting",
    "wetDryStatesRequired": true,
    "lodTextureBudgetRequired": true,
    "darkSceneReadabilityRequired": true,
    "highResolutionFallbackRequired": true,
    "automaticChildInheritance": false,
    "childMaterialsRequireSeparateAgeAppropriateSpecification": true
  }
}
