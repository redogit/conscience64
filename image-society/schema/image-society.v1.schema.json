{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conscience64.local/schema/image-society.v1.schema.json",
  "title": "Conscience64 Image Society v1 Contracts",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "runManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "run_id", "max_calls", "max_parallelism",
        "max_retries_per_call", "checkpoint_every_events",
        "summary_every_events", "max_branches", "promotion_mode",
        "authority_mode", "accessibility_mode"
      ],
      "properties": {
        "schema": { "const": "conscience64/image-society/run-manifest/v1" },
        "run_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "title": { "type": "string", "maxLength": 500 },
        "objective": { "type": "string", "maxLength": 4000 },
        "max_calls": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "max_parallelism": { "type": "integer", "minimum": 1, "maximum": 64 },
        "max_retries_per_call": { "type": "integer", "minimum": 0, "maximum": 10 },
        "checkpoint_every_events": { "type": "integer", "minimum": 1 },
        "summary_every_events": { "type": "integer", "minimum": 1 },
        "max_branches": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "promotion_mode": { "enum": ["manual", "disabled"] },
        "authority_mode": { "enum": ["strict", "review-required"] },
        "accessibility_mode": { "enum": ["enabled", "review-required", "not-applicable"] },
        "allowed_providers": { "$ref": "#/$defs/stringArray" },
        "allowed_renderers": { "$ref": "#/$defs/stringArray" },
        "privacy_classification": { "enum": ["public", "internal", "private", "restricted"] },
        "stop_conditions": { "$ref": "#/$defs/stringArray" },
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "token_in_max": { "type": "number", "minimum": 0 },
            "token_out_max": { "type": "number", "minimum": 0 },
            "cost_currency": { "type": "string", "minLength": 3, "maxLength": 8 },
            "cost_max": { "type": "number", "minimum": 0 },
            "storage_bytes_max": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "imageIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "intent_id", "purpose", "description", "success_criteria", "parent_intent_ids"],
      "properties": {
        "schema": { "const": "conscience64/image-society/intent/v1" },
        "intent_id": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "created_by": { "enum": ["user", "system", "agent"] },
        "title": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "purpose": {
          "enum": [
            "concept-art", "marketing", "world-visualization", "character-sheet",
            "environment", "reference-pack", "repair", "comparison", "research", "other"
          ]
        },
        "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "style": { "$ref": "#/$defs/stringArray" },
            "composition": { "$ref": "#/$defs/stringArray" },
            "content_required": { "$ref": "#/$defs/stringArray" },
            "content_forbidden": { "$ref": "#/$defs/stringArray" },
            "safety": { "$ref": "#/$defs/stringArray" },
            "continuity_targets": { "$ref": "#/$defs/stringArray" },
            "authority_targets": { "$ref": "#/$defs/stringArray" },
            "accessibility_targets": { "$ref": "#/$defs/stringArray" },
            "audience_context": { "$ref": "#/$defs/stringArray" }
          }
        },
        "success_criteria": { "$ref": "#/$defs/stringArray" },
        "parent_intent_ids": { "$ref": "#/$defs/stringArray" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "maxLength": 200 },
        "model": { "type": "string", "maxLength": 200 },
        "model_version": { "type": "string", "maxLength": 200 },
        "renderer_id": { "type": "string", "maxLength": 300 },
        "renderer_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "seed": { "anyOf": [{ "type": "string" }, { "type": "integer" }] },
        "parameters": { "type": "object" },
        "latency_ms": { "type": "number", "minimum": 0 },
        "token_in": { "type": "number", "minimum": 0 },
        "token_out": { "type": "number", "minimum": 0 },
        "cost_estimate": { "type": "number", "minimum": 0 },
        "transport_id": { "type": "string", "maxLength": 200 },
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "response_sha256": { "$ref": "#/$defs/sha256" },
        "determinism_class": {
          "enum": [
            "INPUT_DETERMINISTIC", "REFERENCE_RUNNER_BYTE_IDENTICAL",
            "CROSS_RUNNER_BYTE_IDENTICAL", "VISUAL_EQUIVALENCE",
            "REQUEST_REPLAYABLE_OUTPUT_NONDETERMINISTIC", "UNKNOWN"
          ]
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "category", "severity", "statement", "evidence_basis", "confidence"],
      "properties": {
        "observation_id": { "type": "string", "minLength": 1 },
        "category": {
          "enum": [
            "semantic", "composition", "lighting", "materials", "continuity",
            "anatomy", "readability", "accessibility", "world-consistency",
            "style", "artifact-quality", "science-boundary", "privacy", "other"
          ]
        },
        "severity": { "enum": ["info", "minor", "major", "critical"] },
        "statement": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "evidence_basis": {
          "enum": ["direct-image-inspection", "comparison", "external-rule", "source-reference", "inference"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "region_hint": { "type": "string", "maxLength": 500 },
        "linked_artifact_ids": { "$ref": "#/$defs/stringArray" }
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correction_id", "target_artifact_id", "category", "rationale",
        "intended_delta", "expected_benefit", "risks", "approved"
      ],
      "properties": {
        "correction_id": { "type": "string", "minLength": 1 },
        "target_artifact_id": { "type": "string", "minLength": 1 },
        "category": {
          "enum": [
            "prompt-rewrite", "edit-image", "change-style", "change-composition",
            "fix-continuity", "fix-world-mismatch", "fix-accessibility", "reject-and-regenerate"
          ]
        },
        "rationale": { "type": "string", "minLength": 1 },
        "intended_delta": { "type": "string", "minLength": 1 },
        "expected_benefit": { "$ref": "#/$defs/stringArray" },
        "risks": { "$ref": "#/$defs/stringArray" },
        "approved": { "type": "boolean" },
        "approved_by": { "type": "string", "maxLength": 200 }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluation_id", "artifact_id", "passes", "fails", "unresolved", "recommendation"],
      "properties": {
        "evaluation_id": { "type": "string", "minLength": 1 },
        "artifact_id": { "type": "string", "minLength": 1 },
        "criteria_scores": { "type": "object", "additionalProperties": { "type": "number" } },
        "passes": { "$ref": "#/$defs/stringArray" },
        "fails": { "$ref": "#/$defs/stringArray" },
        "unresolved": { "$ref": "#/$defs/stringArray" },
        "recommendation": { "enum": ["accept", "iterate", "reject", "branch", "escalate-human-review"] }
      }
    },
    "turnEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "event_id", "run_id", "branch_id", "sequence_no", "event_type",
        "input_artifact_ids", "output_artifact_ids", "parent_event_ids", "actor",
        "status", "authority_state"
      ],
      "properties": {
        "schema": { "const": "conscience64/image-society/event/v1" },
        "event_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "branch_id": { "type": "string", "minLength": 1 },
        "sequence_no": { "type": "integer", "minimum": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "event_type": {
          "enum": [
            "plan", "generate", "variation", "edit", "critique", "compare",
            "continuity-review", "accessibility-review", "authority-review",
            "provenance-review", "correction-propose", "evaluate", "integrate",
            "checkpoint", "summarize", "promote", "reject", "archive"
          ]
        },
        "intent_id": { "type": "string" },
        "input_artifact_ids": { "$ref": "#/$defs/stringArray" },
        "output_artifact_ids": { "$ref": "#/$defs/stringArray" },
        "parent_event_ids": { "$ref": "#/$defs/stringArray" },
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["actor_type", "actor_id"],
          "properties": {
            "actor_type": { "enum": ["human", "agent", "system", "provider"] },
            "actor_id": { "type": "string", "minLength": 1 },
            "role": { "type": "string", "maxLength": 200 }
          }
        },
        "request_payload": {},
        "response_payload": {},
        "observations": { "type": "array", "items": { "$ref": "#/$defs/observation" } },
        "corrections": { "type": "array", "items": { "$ref": "#/$defs/correction" } },
        "evaluation": { "$ref": "#/$defs/evaluation" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "authority_state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["world_checked", "accessibility_checked", "continuity_checked", "human_reviewed", "canonical"],
          "properties": {
            "world_checked": { "type": "boolean" },
            "accessibility_checked": { "type": "boolean" },
            "continuity_checked": { "type": "boolean" },
            "human_reviewed": { "type": "boolean" },
            "canonical": { "type": "boolean" },
            "reality_classification": {
              "enum": [
                "ordinary-physical-world", "observed-natural-world", "scientific-observation-reference",
                "processed-scientific-visualization", "game-reconstruction", "anomaly-fantasy-layer",
                "mixed-explicit", "not-applicable"
              ]
            }
          }
        },
        "status": {
          "enum": [
            "succeeded", "failed-input", "failed-policy", "failed-provider",
            "failed-toolchain", "failed-resource", "failed-provenance",
            "timed-out", "cancelled", "retry-exhausted"
          ]
        },
        "attempt_count": { "type": "integer", "minimum": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "artifact_id", "origin", "origin_event_id", "parent_artifact_ids", "status", "authority"],
      "properties": {
        "schema": { "const": "conscience64/image-society/artifact/v1" },
        "artifact_id": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "origin": { "enum": ["generation", "edit", "import", "reference", "derived"] },
        "origin_event_id": { "type": "string", "minLength": 1 },
        "storage_uri": { "type": "string", "maxLength": 4096 },
        "thumbnail_uri": { "type": "string", "maxLength": 4096 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "mime_type": { "type": "string", "maxLength": 200 },
        "parent_artifact_ids": { "$ref": "#/$defs/stringArray" },
        "tags": { "$ref": "#/$defs/stringArray" },
        "status": {
          "enum": [
            "experimental", "candidate", "accepted-noncanonical", "authority-reviewed-candidate",
            "human-approved-asset", "promoted-canonical", "rejected", "archived"
          ]
        },
        "authority": { "enum": ["none", "source-reference"] },
        "provenance": { "$ref": "#/$defs/provenance" },
        "accessibility_metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "alt_text": { "type": "string", "maxLength": 2000 },
            "long_description": { "type": "string", "maxLength": 10000 },
            "text_transcription": { "type": "string", "maxLength": 10000 },
            "regions_of_interest": { "$ref": "#/$defs/stringArray" },
            "known_limitations": { "$ref": "#/$defs/stringArray" }
          }
        }
      }
    },
    "visualDifference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "difference_id", "before_artifact_id", "requested_delta",
        "protected_invariants", "observed_intended_delta", "observed_unintended_delta",
        "remaining_error", "recommendation"
      ],
      "properties": {
        "schema": { "const": "conscience64/image-society/visual-difference/v1" },
        "difference_id": { "type": "string", "minLength": 1 },
        "before_artifact_id": { "type": "string", "minLength": 1 },
        "after_artifact_id": { "type": "string" },
        "requested_delta": { "type": "string", "minLength": 1 },
        "protected_invariants": { "$ref": "#/$defs/stringArray" },
        "observed_intended_delta": { "$ref": "#/$defs/stringArray" },
        "observed_unintended_delta": { "$ref": "#/$defs/stringArray" },
        "remaining_error": { "$ref": "#/$defs/stringArray" },
        "comparison_evidence": { "$ref": "#/$defs/stringArray" },
        "recommendation": { "enum": ["keep", "revert", "iterate-targeted-edit", "branch", "reject", "human-review"] }
      }
    },
    "continuityPack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "pack_id", "version", "entities", "environment_rules", "style_rules", "prohibited_drift"],
      "properties": {
        "schema": { "const": "conscience64/image-society/continuity-pack/v1" },
        "pack_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entity_id", "protected_traits", "variable_traits"],
            "properties": {
              "entity_id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "maxLength": 500 },
              "reference_artifact_ids": { "$ref": "#/$defs/stringArray" },
              "protected_traits": { "$ref": "#/$defs/stringArray" },
              "variable_traits": { "$ref": "#/$defs/stringArray" },
              "authority_class": {
                "enum": ["source-authoritative", "human-approved-working-rule", "generated-working-rule", "experimental"]
              }
            }
          }
        },
        "environment_rules": { "$ref": "#/$defs/stringArray" },
        "material_rules": { "$ref": "#/$defs/stringArray" },
        "style_rules": { "$ref": "#/$defs/stringArray" },
        "prohibited_drift": { "$ref": "#/$defs/stringArray" },
        "source_refs": { "$ref": "#/$defs/stringArray" }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "checkpoint_id", "run_id", "branch_id", "through_sequence_no",
        "accepted_artifacts", "candidate_artifacts", "rejected_artifacts",
        "active_constraints", "unresolved_issues", "budget_consumption",
        "source_event_ids", "state_sha256"
      ],
      "properties": {
        "schema": { "const": "conscience64/image-society/checkpoint/v1" },
        "checkpoint_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "branch_id": { "type": "string", "minLength": 1 },
        "through_sequence_no": { "type": "integer", "minimum": 0 },
        "accepted_artifacts": { "$ref": "#/$defs/stringArray" },
        "candidate_artifacts": { "$ref": "#/$defs/stringArray" },
        "rejected_artifacts": { "$ref": "#/$defs/stringArray" },
        "active_constraints": { "$ref": "#/$defs/stringArray" },
        "continuity_pack_ids": { "$ref": "#/$defs/stringArray" },
        "unresolved_issues": { "type": "array", "items": { "type": "object" } },
        "successful_correction_patterns": { "type": "array", "items": { "type": "object" } },
        "failed_correction_patterns": { "type": "array", "items": { "type": "object" } },
        "authority_notes": { "$ref": "#/$defs/stringArray" },
        "accessibility_notes": { "$ref": "#/$defs/stringArray" },
        "budget_consumption": { "type": "object" },
        "source_event_ids": { "$ref": "#/$defs/stringArray" },
        "state_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "regressionDefect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "defect_id", "category", "source_event_ids", "successful_corrections", "failed_corrections", "replays"],
      "properties": {
        "schema": { "const": "conscience64/image-society/regression-defect/v1" },
        "defect_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "maxLength": 5000 },
        "source_event_ids": { "$ref": "#/$defs/stringArray" },
        "source_artifact_ids": { "$ref": "#/$defs/stringArray" },
        "protected_invariants": { "$ref": "#/$defs/stringArray" },
        "successful_corrections": { "$ref": "#/$defs/stringArray" },
        "failed_corrections": { "$ref": "#/$defs/stringArray" },
        "replays": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["event_id", "result"],
            "properties": {
              "event_id": { "type": "string", "minLength": 1 },
              "result": { "enum": ["passed", "failed", "inconclusive"] },
              "notes": { "type": "string", "maxLength": 5000 }
            }
          }
        }
      }
    },
    "roleEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "role_id", "run_id", "event_id", "intent_id", "input_refs",
        "obligations", "evidence_boundary", "stop_conditions", "output_contract"
      ],
      "properties": {
        "schema": { "const": "conscience64/image-society/role-envelope/v1" },
        "role_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "event_id": { "type": "string", "minLength": 1 },
        "intent_id": { "type": "string", "minLength": 1 },
        "input_refs": { "$ref": "#/$defs/stringArray" },
        "obligations": { "$ref": "#/$defs/stringArray" },
        "evidence_boundary": { "$ref": "#/$defs/stringArray" },
        "stop_conditions": { "$ref": "#/$defs/stringArray" },
        "output_contract": { "type": "object" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/runManifest" },
    { "$ref": "#/$defs/imageIntent" },
    { "$ref": "#/$defs/turnEvent" },
    { "$ref": "#/$defs/artifact" },
    { "$ref": "#/$defs/visualDifference" },
    { "$ref": "#/$defs/continuityPack" },
    { "$ref": "#/$defs/checkpoint" },
    { "$ref": "#/$defs/regressionDefect" },
    { "$ref": "#/$defs/roleEnvelope" }
  ]
}
