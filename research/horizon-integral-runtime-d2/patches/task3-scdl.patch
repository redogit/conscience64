diff -ruN /tmp/task3a/tests/scdl-horizon-ir.test.mjs /tmp/task3b/tests/scdl-horizon-ir.test.mjs
--- /tmp/task3a/tests/scdl-horizon-ir.test.mjs	1970-01-01 00:00:00.000000000 +0000
+++ /tmp/task3b/tests/scdl-horizon-ir.test.mjs	2026-10-30 07:31:23.278874654 +0000
@@ -0,0 +1,45 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {parse,print,compileHorizon,makeDefaultRegistry,HORIZON_IR_SCHEMA} from '../src/scdl/index.js';
+
+const vocabulary=`person purpose question permission working_set pause_point lane identity revision occurrence semantic_object context_support clarity object surface carrier source location containment order component relation morphism observer lens blind_spot calibration independence intent goal obligation consequential_distinction invariant claim evidence counterexample assumption method result meaning provenance authority transformation one_degree_move signed_move inverse reconstruction homeward plan capability cost authorization execution observation residual third_plane progression acceptance migration conflict decay projection`;
+
+test('all D2 declaration families parse and lossless print',()=>{
+  const source=vocabulary.split(' ').map((k,i)=>`${k} d${i} { domain: "d2" }`).join('\n');
+  const p=parse(source); assert.equal(p.kind,'valid'); assert.equal(p.value.declarations.length,vocabulary.split(' ').length);
+  const out=print(p.value,{mode:'lossless'}); assert.equal(out.kind,'valid'); assert.equal(out.value,source);
+});
+
+test('Horizon IR preserves exact integers rationals and UTF-16 source spans',()=>{
+  const source='claim c { domain:"math", big:900719925474099312345, ratio:rational("7","13"), note:"😀" }';
+  const r=compileHorizon(source,makeDefaultRegistry().value); assert.equal(r.kind,'valid');
+  assert.equal(r.value.schema,'horizon-integral-ir/1');
+  const rec=r.value.records[0];
+  assert.deepEqual(rec.body.big,{integer:'900719925474099312345'});
+  assert.deepEqual(rec.body.ratio,{rational:['7','13']});
+  assert.equal(source.slice(rec.source_span.start,rec.source_span.end),source);
+  assert.equal(r.value.source.utf16Length,source.length);
+});
+
+test('Horizon IR output ordering and identities are deterministic',()=>{
+  const source='claim z {domain:"b"}\nclaim a {domain:"a"}';
+  const a=compileHorizon(source,makeDefaultRegistry().value); const b=compileHorizon(source,makeDefaultRegistry().value);
+  assert.deepEqual(a,b); assert.equal(a.value.records[0].name,'z'); assert.match(a.value.records[0].occurrence_id,/^occ:/);
+});
+
+test('evidence cannot jump domains without an explicit bridge obligation',()=>{
+  const bad='claim target {domain:"hodge"}\nevidence e {domain:"physics", subject:target}';
+  const r=compileHorizon(bad,makeDefaultRegistry().value); assert.equal(r.kind,'invalid'); assert(r.diagnostics.some(d=>d.code==='CROSS_DOMAIN_EVIDENCE'));
+  const good='claim target {domain:"hodge"}\nobligation bridge {domain:"horizon", kind:"bridge", fromDomain:"physics", toDomain:"hodge"}\nevidence e {domain:"physics", subject:target}';
+  const g=compileHorizon(good,makeDefaultRegistry().value); assert.notEqual(g.kind,'invalid');
+  const ev=g.value.records.find(x=>x.keyword==='evidence'); assert.equal(ev.effect_class,'evidence'); assert.equal(ev.verification_status,'unverified');
+});
+
+test('compiler retains explicit references and source occurrence table',()=>{
+  const source='semantic_object s {domain:"x"}\nrelation r {domain:"x", subject:s, object:s}';
+  const r=compileHorizon(source,makeDefaultRegistry().value); assert.equal(r.kind,'valid');
+  assert.equal(r.value.source.occurrences.length,2); assert.equal(r.value.references.length,2);
+  assert(r.value.references.every(x=>x.target==='s'));
+});
+
+test('canonical IR schema constant is stable',()=>assert.equal(HORIZON_IR_SCHEMA,'horizon-integral-ir/1'));
