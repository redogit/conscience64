+"use strict";
+const K=`person purpose question permission working_set pause_point lane identity revision occurrence semantic_object context_support clarity object surface carrier source location containment order component relation morphism observer lens blind_spot calibration independence intent goal obligation consequential_distinction invariant claim evidence counterexample assumption method result meaning provenance authority transformation one_degree_move signed_move inverse reconstruction homeward plan capability cost authorization execution observation residual third_plane progression acceptance migration conflict decay projection domain decompose compose world`.split(' ');
+const EFFECT={evidence:'evidence',counterexample:'evidence',claim:'claim',obligation:'obligation',authorization:'authorization',execution:'execution',observation:'observation',transformation:'transformation',inverse:'transformation',reconstruction:'transformation',homeward:'verification',acceptance:'acceptance'};
+export const DECLARATION_SPECS=Object.freeze(Object.fromEntries(K.map(keyword=>[keyword,Object.freeze({irType:`horizon.${keyword}`,requiredFields:Object.freeze([]),referenceFields:Object.freeze([]),domainScoped:true,effectClass:EFFECT[keyword]??'declaration'})])));
+export function declarationSpec(keyword){return DECLARATION_SPECS[keyword]??null;}

