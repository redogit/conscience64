+"use strict";
+import {createHash} from 'node:crypto';
+import {parse} from '../language/parser.js';
+import {compile} from '../language/compile.js';
+import {clone, invalid, deferred, valid, diag} from '../values.js';
+import {declarationSpec} from './declaration-specs.js';
+
+export const HORIZON_IR_SCHEMA='horizon-integral-ir/1';
+const sha=s=>createHash('sha256').update(s,'utf8').digest('hex');
+
+function valueToJson(v){
+  if(v==null||typeof v!=='object') return v;
+  if(typeof v.str==='string') return v.str;
+  if(typeof v.bool==='boolean') return v.bool;
+  if(typeof v.integer==='string') return {integer:v.integer};
+  if(Array.isArray(v.rational)) return {rational:v.rational.slice()};
+  if(typeof v.ref==='string') return {ref:v.ref};
+  if(Array.isArray(v.array)) return v.array.map(valueToJson);
+  if(Array.isArray(v.record)) return Object.fromEntries(v.record.map(([k,x])=>[k,valueToJson(x)]));
+  if(v.hole) return {hole:clone(v.hole)};
+  return clone(v);
+}
+function bodyObject(body){return valueToJson(body)||{};}
+function collectRefs(v,out=[]){
+  if(v&&typeof v==='object'){
+    if(typeof v.ref==='string') out.push(v.ref);
+    else if(Array.isArray(v)) for(const x of v) collectRefs(x,out);
+    else for(const x of Object.values(v)) collectRefs(x,out);
+  }
+  return out;
+}
+function bridges(records){const s=new Set();for(const r of records)if(r.keyword==='obligation'&&r.body?.kind==='bridge'&&r.body.fromDomain&&r.body.toDomain)s.add(`${r.body.fromDomain}->${r.body.toDomain}`);return s;}
+
+export function compileHorizon(sourceOrAst,registry,options={}){
+  const source=typeof sourceOrAst==='string'?sourceOrAst:String(options.source??'');
+  const parsed=typeof sourceOrAst==='string'?parse(source):{kind:'valid',value:sourceOrAst};
+  if(parsed.kind==='invalid')return parsed;
+  const base=compile(parsed.value,registry,options);
+  if(base.kind==='invalid')return base;
+  const sourceSha=sha(source),records=[];
+  for(let i=0;i<parsed.value.declarations.length;i++){
+    const d=parsed.value.declarations[i],spec=declarationSpec(d.keyword),body=bodyObject(d.body),domain=body.domain??options.defaultDomain??'unscoped';
+    const start=d.span?.start??0,end=d.span?.end??source.length;
+    records.push({keyword:d.keyword,ir_type:spec?.irType??`horizon.${d.keyword}`,name:d.name,occurrence_id:`occ:${sourceSha}:${start}:${end}`,semantic_object_id:body.semantic_object_id??null,domain,source_span:{start,end},declaration_revision:i+1,effect_class:spec?.effectClass??'declaration',body});
+  }
+  const byName=new Map(records.map(x=>[x.name,x])),bridge=bridges(records),diagnostics=[];
+  for(const r of records.filter(x=>x.keyword==='evidence')){
+    const subject=typeof r.body.subject==='object'?r.body.subject?.ref:r.body.subject,target=byName.get(subject);
+    if(target&&target.domain!==r.domain&&!bridge.has(`${r.domain}->${target.domain}`)) diagnostics.push(diag('error','CROSS_DOMAIN_EVIDENCE',`Evidence ${r.name} in ${r.domain} cannot attach to ${target.name} in ${target.domain} without a bridge obligation`,r.source_span));
+    r.verification_status='unverified';
+  }
+  if(diagnostics.some(d=>d.severity==='error'))return invalid(diagnostics);
+  const references=[];for(const r of records)for(const target of collectRefs(r.body))references.push({from_occurrence:r.occurrence_id,target});
+  const value={schema:HORIZON_IR_SCHEMA,source:{sha256:sourceSha,utf16Length:source.length,occurrences:records.map(r=>({occurrence_id:r.occurrence_id,span:r.source_span,keyword:r.keyword,name:r.name}))},records,references,obligations:records.filter(r=>r.keyword==='obligation'),diagnostics:[]};
+  return base.kind==='deferred'?deferred(value,base.obligations??[],base.diagnostics??[]):valid(value,base.diagnostics??[]);
+}

